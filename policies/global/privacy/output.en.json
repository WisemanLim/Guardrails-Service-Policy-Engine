{
  "$schema": "https://example.com/guardrails/rule-bundle.schema.json",
  "rules": [
    {
      "ruleId": "PRIV_ID_EN_OUT_001",
      "domain": "global",
      "locale": "en",
      "ioType": "output",
      "category": "pii",
      "subCategory": "ssn_us",
      "description": "Redact SSNs that appear in model output.",
      "patternType": "regex",
      "patterns": { "regex": ["\\b(?!000|666)[0-8]\\d{2}[- ]\\d{2}[- ]\\d{4}\\b"] },
      "severity": "critical",
      "priority": 950,
      "action": "redact",
      "messageTemplate": { "en": "SSNs are redacted in responses.", "ko-KR": "응답에서 SSN은 마스킹됩니다." },
      "regulationTags": ["US_HIPAA", "US_CCPA"],
      "examplesPositive": ["The customer's SSN is 123-45-6789."],
      "examplesNegative": ["Use a placeholder like XXX-XX-XXXX in examples."]
    },
    {
      "ruleId": "PRIV_FIN_EN_OUT_001",
      "domain": "global",
      "locale": "en",
      "ioType": "output",
      "category": "pii",
      "subCategory": "card_number",
      "description": "Redact card numbers that appear in model output.",
      "patternType": "regex+classifier",
      "patterns": { "regex": ["\\b(?:\\d[ -]*?){13,19}\\b"], "luhnCheck": true },
      "severity": "critical",
      "priority": 900,
      "action": "redact",
      "messageTemplate": { "en": "Card numbers are redacted in responses.", "ko-KR": "응답에서 카드번호는 마스킹됩니다." },
      "regulationTags": ["PCI_DSS"],
      "examplesPositive": ["Customer card: 4111 1111 1111 1111"],
      "examplesNegative": ["Use 4111-1111-1111-1111 as a sample sandbox PAN."]
    },
    {
      "ruleId": "PRIV_CONTACT_EN_OUT_001",
      "domain": "global",
      "locale": "en",
      "ioType": "output",
      "category": "pii",
      "subCategory": "email",
      "description": "Redact email addresses in model output.",
      "patternType": "regex",
      "patterns": { "regex": ["\\b[A-Za-z0-9._%+\\-]+@[A-Za-z0-9.\\-]+\\.[A-Za-z]{2,}\\b"] },
      "severity": "medium",
      "priority": 600,
      "action": "redact",
      "messageTemplate": { "en": "Email addresses are redacted.", "ko-KR": "이메일은 마스킹됩니다." },
      "regulationTags": ["US_CCPA", "EU_GDPR"],
      "examplesPositive": ["Contact alice@example.com for refunds."],
      "examplesNegative": ["Use user@example.com as a placeholder."]
    },
    {
      "ruleId": "PRIV_CRED_EN_OUT_001",
      "domain": "global",
      "locale": "en",
      "ioType": "output",
      "category": "credentials",
      "subCategory": "api_key",
      "description": "Redact API keys / secret tokens in model output.",
      "patternType": "regex",
      "patterns": { "regex": ["\\b(?:sk|pk|api|key|token)[_-][A-Za-z0-9_-]{16,}\\b"] },
      "severity": "high",
      "priority": 850,
      "action": "redact",
      "messageTemplate": { "en": "API keys / secrets are redacted.", "ko-KR": "API 키/시크릿은 마스킹됩니다." },
      "regulationTags": [],
      "examplesPositive": ["Your new key is sk_live_ABCDEFGHIJKLMNOPQRSTUVWX."],
      "examplesNegative": ["Store secrets in environment variables."]
    }
  ]
}

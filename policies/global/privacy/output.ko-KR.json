{
  "$schema": "https://example.com/guardrails/rule-bundle.schema.json",
  "rules": [
    {
      "ruleId": "PRIV_ID_KR_OUT_001",
      "domain": "global",
      "locale": "ko-KR",
      "ioType": "output",
      "category": "pii",
      "subCategory": "national_id_kr",
      "description": "응답에서 주민등록번호 발견 시 마스킹",
      "patternType": "regex",
      "patterns": { "regex": ["\\b\\d{6}[- ]?\\d{7}\\b"] },
      "severity": "critical",
      "priority": 950,
      "action": "redact",
      "messageTemplate": { "ko-KR": "주민등록번호는 마스킹 처리됩니다.", "en": "Korean RRN is redacted." },
      "regulationTags": ["KR_PIPA"],
      "examplesPositive": ["고객 주민등록번호는 900101-1234567 입니다."],
      "examplesNegative": ["주민등록번호 체계는 생년월일 6자리와 뒤 7자리로 구성됩니다."]
    },
    {
      "ruleId": "PRIV_FIN_KR_OUT_001",
      "domain": "global",
      "locale": "ko-KR",
      "ioType": "output",
      "category": "pii",
      "subCategory": "card_number",
      "description": "응답에서 카드번호 노출 시 마스킹",
      "patternType": "regex+classifier",
      "patterns": { "regex": ["\\b(?:\\d[ -]*?){13,19}\\b"], "luhnCheck": true },
      "severity": "critical",
      "priority": 900,
      "action": "redact",
      "messageTemplate": { "ko-KR": "카드 번호는 마스킹됩니다.", "en": "Card number is redacted." },
      "regulationTags": ["PCI_DSS"],
      "examplesPositive": ["고객 카드: 4111 1111 1111 1111"],
      "examplesNegative": ["테스트 카드 번호는 4111-1111-1111-1111 형식입니다."]
    },
    {
      "ruleId": "PRIV_CONTACT_KR_OUT_001",
      "domain": "global",
      "locale": "ko-KR",
      "ioType": "output",
      "category": "pii",
      "subCategory": "phone_kr",
      "description": "응답 내 한국 휴대전화 번호 마스킹",
      "patternType": "regex",
      "patterns": { "regex": ["\\b01[016789][- .]?\\d{3,4}[- .]?\\d{4}\\b"] },
      "severity": "high",
      "priority": 800,
      "action": "redact",
      "messageTemplate": { "ko-KR": "연락처는 마스킹 처리됩니다.", "en": "Korean mobile number is redacted." },
      "regulationTags": ["KR_PIPA"],
      "examplesPositive": ["담당자 연락처: 010-1234-5678"],
      "examplesNegative": ["연락처는 본인 인사시스템에서 확인하세요."]
    },
    {
      "ruleId": "PRIV_CRED_KR_OUT_001",
      "domain": "global",
      "locale": "ko-KR",
      "ioType": "output",
      "category": "credentials",
      "subCategory": "api_key",
      "description": "응답 내 API 키/시크릿 토큰 마스킹",
      "patternType": "regex",
      "patterns": { "regex": ["\\b(?:sk|pk|api|key|token)[_-][A-Za-z0-9_-]{16,}\\b"] },
      "severity": "high",
      "priority": 850,
      "action": "redact",
      "messageTemplate": { "ko-KR": "API 키/시크릿은 마스킹 처리됩니다.", "en": "API key/secret is redacted." },
      "regulationTags": [],
      "examplesPositive": ["새 토큰: sk_live_ABCDEFGHIJKLMNOPQRSTUVWX"],
      "examplesNegative": ["토큰은 환경변수에 보관하세요."]
    }
  ]
}
